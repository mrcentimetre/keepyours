# Copy to .env and fill in. Never commit .env.

# --- chain ---
ARBITRUM_RPC=
ARBITRUM_SEPOLIA_RPC=
ARBISCAN_API_KEY=

# --- deployment ---
# use a throwaway deployer key, not your main wallet
DEPLOYER_PRIVATE_KEY=
FEE_SINK_ADDRESS=

# --- contracts (filled in after deploy) ---
NEXT_PUBLIC_CHAIN=arbitrum-sepolia
NEXT_PUBLIC_KEEPVAULT=
NEXT_PUBLIC_USDC=

# --- wallet / gas sponsorship ---
ZERODEV_PROJECT_ID=
ZERODEV_PAYMASTER_URL=

# --- keeper (sweeps forwarders into the vault) ---
KEEPER_PRIVATE_KEY=

# --- alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- waitlist ---
# Google Apps Script web app URL that appends rows to the waitlist sheet.
# Used server-side only, by app/api/waitlist. See docs/WAITLIST.md.
WAITLIST_ENDPOINT=
