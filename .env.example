# Every key used anywhere in the project, for reference. Never commit any
# real .env file — this is the only one that's tracked.
#
# IMPORTANT: each tool only auto-loads its OWN directory's env file — nothing
# here is shared automatically between them (verified empirically, 28 Sep
# 2026; Foundry's docs don't say this outright). Copy the lines you need into:
#   - repo root, as `.env.local`  → the Next.js app (waitlist + product screens)
#   - `contracts/.env`            → Foundry (build, test, deploy)
#   - `keeper/.env`               → the keeper + Telegram bot, once T5.2 scaffolds it

# --- chain --- (contracts/.env)
ARBITRUM_RPC=
ARBITRUM_SEPOLIA_RPC=
ARBISCAN_API_KEY=

# --- deployment --- (contracts/.env)
# use a throwaway deployer key, not your main wallet
DEPLOYER_PRIVATE_KEY=
FEE_SINK_ADDRESS=

# --- contracts, filled in after deploy --- (.env.local; see docs/CONTRACTS.md for the deploy order)
NEXT_PUBLIC_CHAIN=arbitrum-sepolia
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_POOL=
NEXT_PUBLIC_USDC=

# --- wallet / gas sponsorship --- (.env.local; read client-side, see lib/zerodev.ts)
# One v3 URL for both bundler and paymaster, per chain. From the ZeroDev
# dashboard; also set "Sponsor all transactions" on for the chain there, or
# nothing gets sponsored.
NEXT_PUBLIC_ZERODEV_RPC_URL=
# The passkey server URL, also from the dashboard — not derivable from the
# project ID (confirmed by reading @zerodev/webauthn-key's source: it makes
# real HTTP calls to this for the WebAuthn register/login ceremony). That
# dashboard's "Domain" field must match whatever origin you're testing from
# right now (localhost, a tunnel, keepyours.xyz, ...) or passkey creation
# fails outright — see docs/ARCHITECTURE.md's Passkeys section.
NEXT_PUBLIC_ZERODEV_PASSKEY_SERVER_URL=

# --- keeper --- (keeper/.env; calls process()/settle() on vaults, runs on the Hetzner VPS, see docs/RUNBOOK.md)
# dedicated low-value key, never the deployer key
KEEPER_PRIVATE_KEY=

# --- alerts --- (keeper/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- waitlist --- (.env.local)
# Google Apps Script web app URL that appends rows to the waitlist sheet.
# Used server-side only, by app/api/waitlist. See docs/WAITLIST.md.
WAITLIST_ENDPOINT=

# --- analytics (PostHog), app only; set by the Vercel PostHog integration ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
