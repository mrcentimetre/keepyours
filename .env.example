# Every key used anywhere in the project, for reference. Never commit any
# real .env file — this is the only one that's tracked.
#
# IMPORTANT: each tool only auto-loads its OWN directory's env file — nothing
# here is shared automatically between them (verified empirically, 28 Sep
# 2026; Foundry's docs don't say this outright). Copy the lines you need into:
#   - repo root, as `.env.local`  → the Next.js app (waitlist + product screens)
#   - `contracts/.env`            → Foundry (build, test, deploy)
#   - `keeper/.env`               → the keeper + Telegram bot, once T5.2 scaffolds it

# --- chain --- (contracts/.env)
ARBITRUM_RPC=
ARBITRUM_SEPOLIA_RPC=
ARBISCAN_API_KEY=

# --- deployment --- (contracts/.env)
# use a throwaway deployer key, not your main wallet
DEPLOYER_PRIVATE_KEY=
FEE_SINK_ADDRESS=

# --- contracts, filled in after deploy --- (.env.local; see docs/CONTRACTS.md for the deploy order)
NEXT_PUBLIC_CHAIN=arbitrum-sepolia
NEXT_PUBLIC_FACTORY=
NEXT_PUBLIC_POOL=
NEXT_PUBLIC_USDC=

# --- wallet / gas sponsorship --- (.env.local; NEXT_PUBLIC_ prefix TBD when T2.1 wires the passkey flow)
ZERODEV_PROJECT_ID=
ZERODEV_PAYMASTER_URL=

# --- keeper --- (keeper/.env; calls process()/settle() on vaults, runs on the Hetzner VPS, see docs/RUNBOOK.md)
# dedicated low-value key, never the deployer key
KEEPER_PRIVATE_KEY=

# --- alerts --- (keeper/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- waitlist --- (.env.local)
# Google Apps Script web app URL that appends rows to the waitlist sheet.
# Used server-side only, by app/api/waitlist. See docs/WAITLIST.md.
WAITLIST_ENDPOINT=
